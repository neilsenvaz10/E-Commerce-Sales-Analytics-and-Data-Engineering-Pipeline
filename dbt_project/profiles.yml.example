# TEMPLATE ONLY. dbt is not installed yet and this file has not been tested.
# Copy to dbt_project/profiles.yml (Git-ignored) in Phase 5. All values come from
# environment variables (.env); never put a password in this file.
ecommerce_analytics:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('POSTGRES_HOST', 'localhost') }}"
      port: "{{ env_var('POSTGRES_PORT', '5434') | as_number }}"
      user: "{{ env_var('DBT_DB_USER') }}"
      password: "{{ env_var('DBT_DB_PASSWORD') }}"
      dbname: "{{ env_var('POSTGRES_DB') }}"
      schema: staging        # models override this per folder (staging / analytics)
      threads: 4
