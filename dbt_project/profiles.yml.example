# TEMPLATE. Copy to dbt_project/profiles.yml (Git-ignored). All values come from environment
# variables (.env); there is no password: login uses a private key kept OUTSIDE the repository.
# Verified against a real Snowflake account (dbt run, test and validation passed): `private_key_path`
# is the adapter's field for a key file.
ecommerce_analytics:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_DBT_USER', 'TRANSFORM_USER') }}"
      private_key_path: "{{ env_var('SNOWFLAKE_DBT_PRIVATE_KEY_PATH') }}"
      role: TRANSFORM_ROLE
      database: ECOMMERCE_ANALYTICS
      warehouse: ECOMMERCE_WH
      schema: STAGING        # models choose STAGING or ANALYTICS in dbt_project.yml
      threads: 2
