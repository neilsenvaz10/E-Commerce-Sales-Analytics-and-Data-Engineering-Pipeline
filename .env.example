# Copy this file to .env and fill in your own values. NEVER commit .env. Never paste these
# values into chat, screenshots or documents. Private KEY FILES stay outside the repository.

# ============ Main path: Airbyte Cloud + Snowflake ============
# --- Airbyte Cloud (Settings > Applications, then the connection URL) ---
AIRBYTE_API_URL=https://api.airbyte.com/v1
AIRBYTE_CLIENT_ID=your-airbyte-client-id
AIRBYTE_CLIENT_SECRET=your-airbyte-client-secret
AIRBYTE_CONNECTION_ID=your-airbyte-connection-id

# --- Snowflake (account identifier from Snowsight: View account details) ---
SNOWFLAKE_ACCOUNT=your-org-your-account
SNOWFLAKE_DATABASE=ECOMMERCE_ANALYTICS
SNOWFLAKE_WAREHOUSE=ECOMMERCE_WH
# Private key files generated on your machine; use forward slashes, keep them outside the repo.
SNOWFLAKE_DBT_USER=TRANSFORM_USER
SNOWFLAKE_DBT_PRIVATE_KEY_PATH=C:/Users/you/.snowflake/transform_key.p8
SNOWFLAKE_READER_USER=READER_USER
SNOWFLAKE_READER_PRIVATE_KEY_PATH=C:/Users/you/.snowflake/reader_key.p8

# --- dbt ---
DBT_PROFILES_DIR=dbt_project

# ============ Optional fallback: local PostgreSQL warehouse (docker-compose.yml) ============
# Verified earlier but not used by the main path. Replace every change-me with your own password.
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=ecommerce_analytics
POSTGRES_ADMIN_USER=warehouse_admin
POSTGRES_ADMIN_PASSWORD=change-me
PG_RAW_SCHEMA=raw
PG_STAGING_SCHEMA=staging
PG_ANALYTICS_SCHEMA=analytics
AIRBYTE_DB_USER=airbyte_user
AIRBYTE_DB_PASSWORD=change-me
DBT_DB_USER=dbt_user
DBT_DB_PASSWORD=change-me
STREAMLIT_DB_USER=streamlit_ro
STREAMLIT_DB_PASSWORD=change-me
