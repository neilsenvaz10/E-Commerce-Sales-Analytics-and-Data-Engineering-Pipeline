# Copy this file to .env and fill in real values. NEVER commit .env.
# ALL VALUES BELOW ARE DUMMY PLACEHOLDERS. No Google Cloud project, dataset,
# service account, or key exists yet. See documentation/bigquery_setup.md.

# --- Google Cloud / BigQuery ---
# Replace with a real project ID only when a real project exists.
GCP_PROJECT_ID=your-gcp-project-id
# One location for every dataset. Cannot be changed after a dataset is created.
BQ_LOCATION=asia-south1
BQ_RAW_DATASET=raw_online_retail
BQ_STAGING_DATASET=staging_online_retail
BQ_ANALYTICS_DATASET=analytics_online_retail

# Pipeline service account key (Airbyte / dbt / Airflow). Keep the file OUTSIDE
# the project folder. Never commit it.
GOOGLE_APPLICATION_CREDENTIALS=path/to/pipeline-service-account-key.json

# --- dbt ---
DBT_PROFILES_DIR=dbt_project

# --- Airbyte ---
AIRBYTE_API_URL=http://localhost:8000/api/public/v1
AIRBYTE_CLIENT_ID=your-airbyte-client-id
AIRBYTE_CLIENT_SECRET=your-airbyte-client-secret
AIRBYTE_CONNECTION_ID=your-airbyte-connection-id

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW__CORE__LOAD_EXAMPLES=False

# --- Streamlit (read-only dashboard service account key, kept outside the project) ---
STREAMLIT_BQ_CREDENTIALS=path/to/read-only-dashboard-key.json
