# Copy this file to .env and replace every "change-me" value. NEVER commit .env.
# These are placeholders for a LOCAL Docker PostgreSQL warehouse. Choose your own
# strong passwords (letters and digits are safest). Never paste them into chat.

# --- PostgreSQL warehouse (Docker, see docker-compose.yml) ---
# Host port 5434 avoids a clash with a Windows PostgreSQL service on 5432 and with
# another local Docker project that publishes 5433. Change it here if needed.
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=ecommerce_analytics

# Admin account: used only to create the roles and for maintenance.
POSTGRES_ADMIN_USER=warehouse_admin
POSTGRES_ADMIN_PASSWORD=change-me

# Schemas
PG_RAW_SCHEMA=raw
PG_STAGING_SCHEMA=staging
PG_ANALYTICS_SCHEMA=analytics

# Least-privilege roles (created by docker/postgres/sql/init_warehouse.sql)
#   Airbyte  : writes schema raw
AIRBYTE_DB_USER=airbyte_user
AIRBYTE_DB_PASSWORD=change-me
#   dbt      : reads raw, writes staging and analytics
DBT_DB_USER=dbt_user
DBT_DB_PASSWORD=change-me
#   Streamlit: read-only on analytics
STREAMLIT_DB_USER=streamlit_ro
STREAMLIT_DB_PASSWORD=change-me

# --- dbt ---
DBT_PROFILES_DIR=dbt_project

# --- Airbyte (Phase 4) ---
AIRBYTE_API_URL=http://localhost:8000/api/public/v1
AIRBYTE_CLIENT_ID=your-airbyte-client-id
AIRBYTE_CLIENT_SECRET=your-airbyte-client-secret
AIRBYTE_CONNECTION_ID=your-airbyte-connection-id

# --- Airflow (Phase 6) ---
AIRFLOW_UID=50000
AIRFLOW__CORE__LOAD_EXAMPLES=False
